# ============================================================
# NEXORA — Soft UI Gaming Donation Platform
# Copy this file to .env and fill in your values.
# .env faylini shu fayldan nusxalab oling va to'ldiring.
# ============================================================

# --- Telegram bot (@BotFather dan olingan token) ---
BOT_TOKEN=
# WebApp manzili (HTTPS bo'lishi shart, masalan: https://nexora-xxxx.e2b.app)
WEBAPP_URL=http://localhost:5000
# Admin telegram chat ID (yangi buyurtmalar haqida xabar keladi, ixtiyoriy)
ADMIN_CHAT_ID=

# --- Admin panel paroli (paneldan ham o'zgartirish mumkin) ---
ADMIN_PASSWORD=admin123

# --- Flask ---
SECRET_KEY=nexora-soft-ui-secret-change-me
HOST=0.0.0.0
PORT=5000

# --- MySQL (asosiy baza). Bo'sh qolsa SQLite fallback ishlaydi ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=nexora

# --- Yuklash limiti (MB) ---
MAX_UPLOAD_MB=8
